# Copy this file to `.env` and fill in your values.
# `.env` is gitignored.

# MySQL connection — Prisma uses one URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Default WAMP: user=root, empty password, port=3306
DATABASE_URL="mysql://root:@localhost:3306/angular_tutorial"

# JWT signing secret. Anything long and random. Must be the same between restarts
# or every existing login breaks.
JWT_SECRET="replace-me-with-a-long-random-string"

# Port the Express server listens on.
PORT=3000
